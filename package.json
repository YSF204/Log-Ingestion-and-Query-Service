{
  "name": "log-ingestion-and-query-service",
  "version": "1.0.0",
  "description": "High-throughput PostgreSQL log ingestion and query service",
  "scripts": {
    "build": "npm run build:server && npm run build:dashboard",
    "build:server": "tsc --noEmit",
    "build:dashboard": "npm --prefix dashboard run build",
    "lint:dashboard": "npm --prefix dashboard run lint",
    "test": "vitest run src/tests",
    "test:watch": "vitest",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "drizzle-kit migrate",
    "start": "tsx src/server.ts",
    "test:smoke": "vitest run src/smoke/contract-smoke.test.ts",
    "test:load": "docker compose -f docker-compose.yml -f docker-compose.load.yml --profile load-test up -d --build --wait --wait-timeout 60 db app && docker compose -f docker-compose.yml -f docker-compose.load.yml --profile load-test run --rm --no-deps k6"
  },
  "license": "ISC",
  "type": "commonjs",
  "workspaces": [
    "dashboard"
  ],
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
